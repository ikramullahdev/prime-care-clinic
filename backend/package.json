{
  "name": "prime-care-clinic-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for Prime Care Clinic & Diabetes Center appointment management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/appointment_slots.test.js tests/appointments.mock.test.js tests/appointments.postgres.test.js",
    "test:appointments:postgres": "node --test tests/appointments.postgres.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma migrate deploy && node prisma/seed.js"
  },
  "keywords": [
    "healthcare",
    "clinic",
    "appointment-system",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Prime Care Clinic Architecture Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.21.1"
  }
}
