# Prime Care Clinic — Backend Environment Variables
PORT=5000
NODE_ENV=development

# PostgreSQL connection string via Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primecare_db?schema=public"

# Cryptographic JWT Secret for Admin Authentication (change in production)
JWT_SECRET="primecare-super-secure-jwt-secret-key-2026-production"
JWT_EXPIRES_IN="8h"

# CORS Allowed Origin for Frontend
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8080"
