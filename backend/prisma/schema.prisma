// Prime Care Clinic & Diabetes Center
// Prisma Schema for Appointment Management Architecture & Patient Registration System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  DOCTOR
  LAB_TECHNICIAN
  RADIOLOGY_TECHNICIAN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VisitStatus {
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DiagnosticOrderType {
  LAB
  RADIOLOGY
}

enum DiagnosticOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Admin {
  id                String                  @id @default(uuid())
  email             String                  @unique
  name              String
  passwordHash      String
  role              Role                    @default(ADMIN)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdPatients   Patient[]               @relation("PatientCreatedBy")
  updatedPatients   Patient[]               @relation("PatientUpdatedBy")
  checkedInVisits   Visit[]                 @relation("VisitCheckedInBy")
  consultations     Consultation[]
  diagnosticOrders  DiagnosticOrder[]
  diagnosticResults DiagnosticOrderResult[]
  doctorId          String?                 @unique
  doctorProfile     Doctor?                 @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@map("admins")
}

model Doctor {
  id                  String        @id @default(uuid())
  name                String
  title               String?
  specialty           String?
  bio                 String?
  isVerified          Boolean       @default(false)
  isActive            Boolean       @default(true)
  scheduleDays        String        @default("Mon,Tue,Wed,Thu,Sat") // Comma-separated
  startTime           String        @default("17:30")
  endTime             String        @default("22:00")
  slotDurationMinutes Int           @default(20)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  appointments        Appointment[]
  adminAccount        Admin?

  @@map("doctors")
}

model Patient {
  id                       String         @id @default(uuid())
  mrn                      String         @unique // Format: PCC-YYYY-XXXXX
  fullName                 String
  dateOfBirth              DateTime?
  isAgeEstimated           Boolean        @default(false)
  estimatedAge             Int?
  gender                   Gender
  phone                    String
  email                    String?
  address                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  bloodGroup               String?
  notes                    String?
  isActive                 Boolean        @default(true)
  createdById              String?
  createdBy                Admin?         @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById              String?
  updatedBy                Admin?         @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  appointments             Appointment[]
  visits                   Visit[]
  consultations            Consultation[]

  @@index([phone])
  @@index([fullName])
  @@index([createdAt])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(uuid())
  patientName     String
  patientPhone    String
  patientEmail    String?
  serviceType     String
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId       String?
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  preferredDate   String // Format: YYYY-MM-DD
  preferredTime   String // Format: HH:MM AM/PM - HH:MM AM/PM
  appointmentDate DateTime          @db.Date
  slotStart       String            @db.VarChar(5)
  status          AppointmentStatus @default(PENDING)
  notes           String?
  consentAgreed   Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  visits          Visit[]

  @@index([doctorId, preferredDate])
  @@index([patientId])
  @@index([status])
  // The active-status partial unique index is maintained by custom PostgreSQL migration SQL.
  @@map("appointments")
}

model Visit {
  id               String            @id @default(uuid())
  visitNumber      String            @unique
  checkedInAt      DateTime          @default(now())
  status           VisitStatus       @default(CHECKED_IN)
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId    String?
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  checkedInById    String?
  checkedInBy      Admin?            @relation("VisitCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  consultation     Consultation?
  diagnosticOrders DiagnosticOrder[]

  @@index([checkedInAt])
  @@index([patientId, checkedInAt])
  @@index([appointmentId, status])
  @@map("visits")
}

model Consultation {
  id                   String   @id @default(uuid())
  visitId              String   @unique
  visit                Visit    @relation(fields: [visitId], references: [id], onDelete: Restrict)
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  authorId             String
  author               Admin    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  chiefComplaint       String
  presentIllness       String?
  medicalHistory       String?
  allergies            String?
  examinationFindings  String?
  provisionalDiagnosis String?
  finalDiagnosis       String?
  consultationNotes    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([authorId, createdAt])
  @@map("consultations")
}

model DiagnosticOrder {
  id                 String                 @id @default(uuid())
  visitId            String
  visit              Visit                  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  orderedById        String
  orderedBy          Admin                  @relation(fields: [orderedById], references: [id], onDelete: Restrict)
  result             DiagnosticOrderResult?
  type               DiagnosticOrderType
  testName           String                 @db.VarChar(200)
  clinicalIndication String?                @db.VarChar(2000)
  notes              String?                @db.VarChar(2000)
  status             DiagnosticOrderStatus  @default(ORDERED)
  createdAt          DateTime               @default(now())

  @@index([visitId, createdAt])
  @@index([orderedById, createdAt])
  @@map("diagnostic_orders")
}

model DiagnosticOrderResult {
  id                String          @id @default(uuid())
  diagnosticOrderId String          @unique
  diagnosticOrder   DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Restrict)
  findings          String          @db.Text
  interpretation    String?         @db.Text
  resultedById      String
  resultedBy        Admin           @relation(fields: [resultedById], references: [id], onDelete: Restrict)
  resultedAt        DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([resultedById, resultedAt])
  @@map("diagnostic_order_results")
}
